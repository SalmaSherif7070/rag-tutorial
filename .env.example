# Copy this file to ".env" and fill in your own keys.
#   PowerShell:  Copy-Item .env.example .env

# --- API keys you must provide ---
# Free Jina key: https://jina.ai/embeddings/  (click "API")
JINA_API_KEY=your_jina_api_key_here
# Free Google AI Studio key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# --- Qdrant (the local Docker container) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Model settings (sane defaults, change only if you know why) ---
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=1024
GEMINI_MODEL=gemini-2.5-flash
RETRIEVAL_TOP_K=5
